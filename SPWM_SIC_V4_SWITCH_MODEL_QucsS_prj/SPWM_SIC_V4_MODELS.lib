* =====================================================================
* SPWM SIC V4 - ROBUST QUCS-S / NGSPICE MODELS
* File: SPWM_SIC_V4_MODELS.lib
*
* PIN ORDER
* SPWM_CORE:
*   COM PWM_AH PWM_AL PWM_BH PWM_BL PWM_CH PWM_CL
*   REF_A REF_B REF_C CARRIER
*
* SIC_PHASE_LEG:
*   DC_POS DC_NEG PWM_H PWM_L POLE VGS_H VGS_L
* =====================================================================

.SUBCKT SPWM_CORE COM PWM_AH PWM_AL PWM_BH PWM_BL PWM_CH PWM_CL REF_A REF_B REF_C CARRIER PARAMS: FOUT=50 FSW=40K MA=0.85 ACAR=1 VLOGIC=5 DEADBAND=0.04 ROUT=10

BREF_A REF_A COM V={MA*ACAR*SIN(2*PI*FOUT*TIME)}
BREF_B REF_B COM V={MA*ACAR*SIN(2*PI*FOUT*TIME-2*PI/3)}
BREF_C REF_C COM V={MA*ACAR*SIN(2*PI*FOUT*TIME+2*PI/3)}
BTRI CARRIER COM V={ACAR*(2/PI)*ASIN(SIN(2*PI*FSW*TIME))}

BAH N_AH COM V={V(REF_A,CARRIER)>DEADBAND ? VLOGIC : 0}
BAL N_AL COM V={V(CARRIER,REF_A)>DEADBAND ? VLOGIC : 0}
BBH N_BH COM V={V(REF_B,CARRIER)>DEADBAND ? VLOGIC : 0}
BBL N_BL COM V={V(CARRIER,REF_B)>DEADBAND ? VLOGIC : 0}
BCH N_CH COM V={V(REF_C,CARRIER)>DEADBAND ? VLOGIC : 0}
BCL N_CL COM V={V(CARRIER,REF_C)>DEADBAND ? VLOGIC : 0}

RAH N_AH PWM_AH {ROUT}
RAL N_AL PWM_AL {ROUT}
RBH N_BH PWM_BH {ROUT}
RBL N_BL PWM_BL {ROUT}
RCH N_CH PWM_CH {ROUT}
RCL N_CL PWM_CL {ROUT}

RPD_AH PWM_AH COM 10MEG
RPD_AL PWM_AL COM 10MEG
RPD_BH PWM_BH COM 10MEG
RPD_BL PWM_BL COM 10MEG
RPD_CH PWM_CH COM 10MEG
RPD_CL PWM_CL COM 10MEG
.ENDS SPWM_CORE


.MODEL SIC_SW SW(RON=0.05 ROFF=100MEG VT=2.5 VH=0.15)
.MODEL SIC_BODY D(IS=1E-12 N=1.2 RS=0.02 CJO=200P TT=20N BV=1200 IBV=1M)

.SUBCKT SIC_PHASE_LEG DC_POS DC_NEG PWM_H PWM_L POLE VGS_H VGS_L
SH DC_POS POLE PWM_H DC_NEG SIC_SW
DH POLE DC_POS SIC_BODY

SL POLE DC_NEG PWM_L DC_NEG SIC_SW
DL DC_NEG POLE SIC_BODY

BGH VGS_H DC_NEG V={V(PWM_H,DC_NEG)>2.5 ? 18 : -3.5}
BGL VGS_L DC_NEG V={V(PWM_L,DC_NEG)>2.5 ? 18 : -3.5}

RPH PWM_H DC_NEG 10MEG
RPL PWM_L DC_NEG 10MEG
RPOLE POLE DC_NEG 100MEG
CH DC_POS POLE 100P
CL POLE DC_NEG 100P
.ENDS SIC_PHASE_LEG

* =====================================================================
* END
* =====================================================================
