TEXT 48 560 Left 2 ;This ASC is a graphical architecture and executable wrapper. Detailed editable component netlists are in:
TEXT 48 592 Left 2 ;DCLINK_PHYSICAL_PLANT.inc and DCLINK_PHYSICAL_MODELS.lib
TEXT 48 640 Left 2 !.param VPACK=800 VCOIL=12 VLOGIC=5 RBAT=25m LBAT=1u RHAR=22m LHAR=2u
.param RPRE25=92 TCRPRE=100u TEMPAMB=25 RPRE_EFFECTIVE={RPRE25*(1+TCRPRE*(TEMPAMB-25))}
.param LPRE=250n CDC=1m CESR=8m CESL=100n RLEAK=100k RDIS=1k
.param RCOIL_MAIN=12 LCOIL_MAIN=80m RCOIL_PRE=24 LCOIL_PRE=60m EPACK=0 ELINK=0
.param RNEG_COIL_FAULT=10m RPOS_COIL_FAULT=10m RPRE_COIL_FAULT=10m
.param RPOS_PATH_FAULT=10u RDIS_PATH_FAULT=10u F_POS_WELD=0 F_PRE_WELD=0
.include DCLINK_PHYSICAL_PLANT.inc
.tran 0 6 0 5u uic
.options plotwinsize=0 reltol=.001 abstol=100n vntol=100u method=gear
.meas tran I_PRE_PEAK MAX abs(I(RPRE_PATH)) FROM=2m TO=400m
.meas tran T_MAIN_CONTACT WHEN V(POS_MECH)=6 RISE=1
.meas tran VDC_AT_CLOSE FIND V(DCPLUS,DCMINUS) WHEN V(POS_MECH)=6 RISE=1
.meas tran VPACK_AT_CLOSE FIND V(HVP_BUS) WHEN V(POS_MECH)=6 RISE=1
.meas tran V_RATIO_CLOSE PARAM VDC_AT_CLOSE/VPACK_AT_CLOSE
.meas tran T_TO_60 TRIG V(DIS_REQ) VAL=2.5 RISE=1 TARG V(DCPLUS,DCMINUS) VAL=60 FALL=1
TEXT 48 1000 Left 2 ;Plot V(HVP_BUS), V(DCPLUS,DCMINUS), I(RPRE_PATH), V(NEG_MECH), V(PRE_MECH), V(POS_MECH), V(PRE_GATE), V(POS_GATE), V(RUN_OK).

