Version 4
SHEET 1 1800 1120
TEXT 48 24 Left 2 ;800 V DC-LINK CR-004 - CLOSED-LOOP PRECHARGE, MAIN CONTACTORS AND ACTIVE DISCHARGE
TEXT 48 48 Left 2 ;Portable model: standard LTspice voltage, behavioral voltage, resistor, inductor and capacitor symbols only
TEXT 48 760 Left 2 !.param VPACK=800 RBATP=47m RPRE25=92 TCRPRE=100u TEMPAMB=25 TCMD=2.5m
.param RPRE={RPRE25*(1+TCRPRE*(TEMPAMB-25))} CDC=1m CESR=8m CESL=100n
.param RCONT=850u RDIS=1k EPACK=0 ELINK=0 THRESH=.93 TSHUT=1
.tran 0 6 0 5u UIC
.options plotwinsize=0 reltol=.001 abstol=1u vntol=100u method=gear
.meas tran I_PRE_PEAK MAX abs(I(RPRE)) FROM=12m TO=1
.meas tran T_MAIN WHEN V(POS_CMD)=2.5 RISE=1
.meas tran VDC_CLOSE FIND V(DCPLUS) WHEN V(POS_CMD)=2.5 RISE=1
.meas tran VPACK_CLOSE FIND V(HVP) WHEN V(POS_CMD)=2.5 RISE=1
.meas tran V_RATIO_CLOSE PARAM VDC_CLOSE/VPACK_CLOSE
.meas tran E_PRE INTEG I(RPRE)*I(RPRE)*RPRE FROM=12m TO=1
.meas tran T_TO_60 TRIG V(DIS_CMD) VAL=2.5 RISE=1 TARG V(DCPLUS) VAL=60 FALL=1
.meas tran VDC_5S FIND V(DCPLUS) AT=5
TEXT 56 104 Left 2 ;BATTERY AND NEGATIVE MAIN CONTACTOR
SYMBOL res 80 64 R0
SYMATTR InstName RBATP
SYMATTR Value {RBATP}
SYMBOL voltage 80 160 R0
SYMATTR InstName VBAT
SYMATTR Value {VPACK}
SYMBOL res 80 272 R0
SYMATTR InstName RNEG_SW
SYMATTR Value R=if(V(NEG_CMD)>2.5,.5m,1G)
SYMBOL res 80 368 R0
SYMATTR InstName RNEG_C
SYMATTR Value {RCONT}
SYMBOL ind 80 464 R0
SYMATTR InstName LNEG
SYMATTR Value 80n
WIRE 96 80 96 64
FLAG 96 64 HVP
WIRE 96 160 96 176
WIRE 96 256 96 288
WIRE 96 368 96 384
WIRE 96 464 96 480
WIRE 96 560 96 720
FLAG 96 720 DCMINUS
FLAG 96 720 0

TEXT 272 104 Left 2 ;POSITIVE MAIN CONTACTOR
SYMBOL res 304 64 R0
SYMATTR InstName RPOS_SW
SYMATTR Value R=if(V(POS_CMD)>2.5,.5m,1G)
SYMBOL res 304 160 R0
SYMATTR InstName RPOS_C
SYMATTR Value {RCONT}
SYMBOL ind 304 256 R0
SYMATTR InstName LPOS
SYMATTR Value 80n
WIRE 96 80 320 80
WIRE 320 160 320 176
WIRE 320 256 320 272
WIRE 320 352 320 400
FLAG 320 400 DCPLUS

TEXT 496 104 Left 2 ;PRECHARGE CONTACTOR AND 92 OHM PULSE BANK
SYMBOL res 528 64 R0
SYMATTR InstName RPRE_SW
SYMATTR Value R=if(V(PRE_CMD)>2.5,.5m,1G)
SYMBOL res 528 160 R0
SYMATTR InstName RPRE
SYMATTR Value {RPRE}
SYMBOL ind 528 256 R0
SYMATTR InstName LPRE
SYMATTR Value 250n
WIRE 320 80 544 80
WIRE 544 160 544 176
WIRE 544 256 544 272
WIRE 544 352 544 400
WIRE 320 400 544 400

TEXT 720 424 Left 2 ;DC-LINK CAPACITOR BANK WITH ESL AND ESR
SYMBOL ind 752 384 R0
SYMATTR InstName LESL
SYMATTR Value {CESL}
SYMBOL res 752 480 R0
SYMATTR InstName RESR
SYMATTR Value {CESR}
SYMBOL cap 752 576 R0
SYMATTR InstName CDC
SYMATTR Value {CDC}
SYMATTR SpiceLine IC=0
WIRE 544 400 768 400
WIRE 768 480 768 496
WIRE 768 576 768 592
WIRE 768 672 768 720
WIRE 96 720 768 720

TEXT 928 424 Left 2 ;PASSIVE LEAKAGE
SYMBOL res 976 384 R0
SYMATTR InstName RLEAK
SYMATTR Value 100k
WIRE 768 400 992 400
WIRE 992 480 992 720
WIRE 768 720 992 720

TEXT 1136 424 Left 2 ;ACTIVE DISCHARGE
SYMBOL res 1200 384 R0
SYMATTR InstName RDIS_SW
SYMATTR Value R=if(V(DIS_CMD)>2.5,.8,1G)
SYMBOL res 1200 480 R0
SYMATTR InstName RACTIVE
SYMATTR Value {RDIS}
WIRE 992 400 1216 400
WIRE 1216 480 1216 496
WIRE 1216 576 1216 720
WIRE 992 720 1216 720

TEXT 1360 104 Left 2 ;SENSING AND AUTOMATIC SUPERVISORY COMMANDS
SYMBOL bv 1376 144 R0
SYMATTR InstName BPACK_SNS
SYMATTR Value V=V(HVP)*(1+EPACK)
SYMBOL bv 1536 144 R0
SYMATTR InstName BVDC_SNS
SYMATTR Value V=V(DCPLUS)*(1+ELINK)
FLAG 1392 160 VPACK_SNS
FLAG 1552 160 VDC_SNS
FLAG 1392 240 0
FLAG 1552 240 0
SYMBOL bv 1376 288 R0
SYMATTR InstName BNEG_CMD
SYMATTR Value V=if(time>=2m&&time<TSHUT,5,0)
SYMBOL bv 1536 288 R0
SYMATTR InstName BPOS_RAW
SYMATTR Value V=if(time>=12m&&time<TSHUT&&V(VPACK_SNS)>100&&V(VDC_SNS)>=THRESH*V(VPACK_SNS),5,0)
FLAG 1392 304 NEG_CMD
FLAG 1552 304 POS_RAW
FLAG 1392 384 0
FLAG 1552 384 0
SYMBOL bv 1376 448 R0
SYMATTR InstName BPRE_CMD
SYMATTR Value V=if(time>=12m&&time<TSHUT&&V(POS_CMD)<2.5,5,0)
SYMBOL bv 1536 448 R0
SYMATTR InstName BDIS_CMD
SYMATTR Value V=if(time>=1.002,5,0)
FLAG 1392 464 PRE_CMD
FLAG 1552 464 DIS_CMD
FLAG 1392 544 0
FLAG 1552 544 0
SYMBOL res 1648 288 R0
SYMATTR InstName RPOS_DELAY
SYMATTR Value 1k
SYMBOL cap 1648 400 R0
SYMATTR InstName CPOS_DELAY
SYMATTR Value {TCMD/(1000*ln(2))}
WIRE 1680 304 1664 304
FLAG 1680 304 POS_RAW
WIRE 1664 384 1664 416
FLAG 1664 400 POS_FILT
FLAG 1664 496 0
SYMBOL bv 1536 592 R0
SYMATTR InstName BPOS_CMD
SYMATTR Value V=if(V(POS_FILT)>2.5,5,0)
FLAG 1552 608 POS_CMD
FLAG 1552 688 0

TEXT 48 1040 Left 2 ;Plot V(HVP), V(DCPLUS), I(RPRE), V(NEG_CMD), V(PRE_CMD), V(POS_CMD), V(DIS_CMD). Review View > SPICE Error Log for .meas results.
