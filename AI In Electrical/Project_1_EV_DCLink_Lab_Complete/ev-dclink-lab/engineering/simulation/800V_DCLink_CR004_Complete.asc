TEXT 64 40 Left 2 !.param VPACK=800 RBAT=35m RHAR=12m RPRE=92 CDC=1000u CESR=8m CESL=100n RDIS=1k\n.tran 0 6 0 5u UIC\n.options plotwinsize=0 reltol=.001\n.model SWC SW(Ron=.5m Roff=1G Vt=2.5 Vh=.2)\n.model SWD SW(Ron=.2 Roff=1G Vt=2.5 Vh=.2)\n.meas tran I_PRE_PEAK MAX abs(I(RPRE)) FROM=12m TO=345m\n.meas tran VDC_MAIN FIND V(DCPLUS,DCMINUS) AT=345m\n.meas tran V_RATIO PARAM VDC_MAIN/VPACK\n.meas tran T_SAFE WHEN V(DCPLUS,DCMINUS)=60 FALL=1
